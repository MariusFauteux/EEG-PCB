(version 1)
# Step 14 custom rules (generated by scripts/pcb_place.py). Later rules take precedence over earlier ones.
# Pads of one land pattern keep the spacing of the manufacturer drawing (0.10 mm on the TI FemtoFET, 0.175 mm on the
# 0.4 mm WCSP); JLCPCB multilayer minimum is 0.09 mm. Pads of different parts are kept far apart by the courtyards.
(rule "Land-pattern pad spacing"
	(constraint clearance (min 0.09mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad'"))
# USB 2.0 pair: 90 ohm differential on F.Cu over In1 GND (JLC04161H-3313, estimate in the Step 14 review).
# GCT USB4105 land pattern (KiCad stock, per GCT drawing): GND pads A1/A12/B1/B12 sit 0.194 mm from the NPTH
# alignment pegs, 6 um under the 0.20 mm hole clearance used elsewhere. Accepted for this footprint only (review 4.3).
(rule "USB4105 peg clearance"
	(constraint hole_clearance (min 0.19mm))
	(condition "A.memberOfFootprint('J310') && B.memberOfFootprint('J310')"))
(rule "USB 90 ohm pair"
	(condition "A.NetClass == 'USB_90R'")
	(constraint track_width (opt 0.15mm))
	(constraint diff_pair_gap (opt 0.18mm))
	(constraint skew (max 0.15mm)))
# Electrode inputs: wider clearance to everything else (leakage and 100 V fault margin, Step 7/13).
(rule "Analogue input clearance"
	(condition "A.NetClass == 'Analog_in' && B.NetClass != 'Analog_in' && !(A.Type == 'Pad' && B.Type == 'Pad')")
	(constraint clearance (min 0.3mm)))
# D36: isolated trigger side keeps 8 mm clearance and creepage to every other net. Items without a net (the BNC
# mounting pegs, mounting holes) are covered by the barrier rule area instead.
(rule "Trigger isolation 8 mm clearance"
	(constraint clearance (min 8mm))
	(condition "A.NetClass == 'Trigger_iso' && B.NetClass != 'Trigger_iso' && B.NetName != ''"))
(rule "Trigger isolation 8 mm creepage"
	(constraint creepage (min 8mm))
	(condition "A.NetClass == 'Trigger_iso' && B.NetClass != 'Trigger_iso' && B.NetName != ''"))
