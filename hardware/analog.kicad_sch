 118.11 95.901 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "70d841a9-4c26-4510-9e70-b58b0049e74f")) (rectangle (start 214.63 87.63) (end 257.22 118.04) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "74dd2422-13f3-46d5-bb69-2bcd84c6e1f1")) (text "Power flags" (exclude_from_sim no) (at 218.44 89.916 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "985f941c-7817-4f6d-9b17-eebfafcef1f9")) (text "ERC declarations for supplies that" (exclude_from_sim no) (at 218.44 93.716 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "9064b122-9476-42dc-977b-16187b14a518")) (text "enter from other sheets." (exclude_from_sim no) (at 218.44 95.901 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "4e10f782-401d-4c75-b0b5-8c4778f53455")) (rectangle (start 15.24 135.89) (end 190.762 178.456) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "550cdd62-df8b-4911-911a-602e881d22f0")) (text "AVDD backfeed clamp (Step 12)" (exclude_from_sim no) (at 19.05 138.176 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "b0bcbc20-d663-452e-9348-e535a6be23dd")) (text "Rail off: Q201 gate follows +5VA through R209, so current pushed into +5VA by the input clamp diodes turns Q201 on and R208 sinks it (<= 1.3 V modelled at 30-100 V" (exclude_from_sim no) (at 19.05 141.976 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "9534b4b2-db77-4c07-afa8-c55ebf33e3b1")) (text "faults). Rail on: Q202 grounds the gate (5 uA in R209). Also discharges +5VA after a stop." (exclude_from_sim no) (at 19.05 144.161 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "c922490e-d1af-4213-946b-2b2db5f7c5c1")) (rectangle (start 198.12 135.89) (end 403.54 155.365) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "258a1876-b64d-4521-aa60-aa12f02c32d0")) (text "Sheet notes" (exclude_from_sim no) (at 201.93 138.176 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "72ff4146-4981-4ab1-a68a-f5e4c5b1ff7b")) (text "SYS comes from the BQ25798 power path (charger sheet): the pack through the battery FET when on battery. Bench only; no human connection." (exclude_from_sim no) (at 201.93 141.976 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "f50868e2-ea8d-481c-85bd-afc948e98451")) (text "Layout: OUTS Kelvin-sensed at the output capacitors; SET node, CSET and RSET return Kelvin to the same ground. ILIM (~100 mA) is not patient protection." (exclude_from_sim no) (at 201.93 144.161 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "2b8e3467-5d17-4409-9ec7-d61393de9c19")) (text "Reverse-current protection does not stop back-powering through signal pins. Q201 now holds +5VA down whenever ANA_ENABLE is low, powered or not (Step 12). ADC I/O gating is on the adc_interface sheet." (exclude_from_sim no) (at 201.93 146.346 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "1c363ace-07b0-445a-b008-c2cee9b9a29d")))